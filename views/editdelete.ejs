<!DOCTYPE html>
<html>
<head>
    <title>Property Dealer</title>
     
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Tinos:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <link rel="stylesheet" href="/stylesheets/property.css">
    <script src="/javascripts/project.js"></script>
</head>
<body>
  <form  action="/property/final_edit_delete" method="post">
    <input type="hidden" name="propertyid" value="<%=data.propertyid %>">
<div class="root">
    <div class="box">
        <div class="boxdiv">

            <div class="circle">
                <img src="/images/house.png" class="logo">
            </div>

            <div class="boxnew">
                <div style="font-size: 22px; font-weight: bold;">Edit/Delete Item Property</div>
            </div>

            <div class="chek">
                <a href="/property/display_all" style="cursor: pointer; text-decoration: none;">
                <img src="/images/checklist.png" class="cheked">
                </a>
               </div>

        </div>

        <div class="container">

            <div class="row mt-2">
                <div class="col-6">
                    <div><b>State Name</b></div>
                    <select name="stateid" id="stateid" class="form-select">
                        <option selected value="<%=data.stateid %>"><%=data.statename %></option>                        
                    </select>
                </div>


                <div class="col-6">
                    <div><b>City Name</b></div>
                        <select name="cityid" id="cityid"  class="form-select">
                            <option selected value="<%=data.cityid %>"><%=data.cityname %></option>    
                    </select>
                </div>
            </div>


            <div class="row mt-2">
                <div class="col-12">
                    <div><b>Place Name</b></div>
                    <select name="placeid" id="placeid"  class="form-select">
                        <option selected value="<%=data.placeid %>"><%=data.placename %></option>
                    </select>
                </div>
            </div>

            
            <div class="row mt-2">
                <div class="col-6">
                    <div><b>Owner Name</b></div>
                    <input required type="text" name="ownername" value="<%=data.ownername %>" class="form-control" placeholder="Enter owner name">
                </div>

                <div class="col-6">
                    <div><b>Mobile No</b></div>
                    <input required pattern="[0-9]+" type="text" name="mobileno" value="<%=data.mobileno %>" class="form-control" placeholder="Enter mobile number">
                </div>
            </div>

            
            <div class="row mt-2">
                <div class="col-12">
                    <div><b>Email ID</b></div>
                    <input required type="email" name="emailid" value="<%=data.emailid %>" class="form-control" placeholder="Enter email address">
                </div>
            </div>

    
            <div class="row mt-2">
                <div class="col-6">
                    <div><b>Area (sq ft)</b></div>
                    <input required type="text" name="area" value="<%=data.area %>" class="form-control" placeholder="e.g. 1200">
                </div>

                <div class="col-6">
                    <div><b>Price (₹)</b></div>
                    <input required pattern="[0-9]+" type="text" name="price" value="<%=data.price %>" class="form-control" placeholder="e.g. 500000">
                </div>
            </div>

            
            <div class="row mt-2">
                <div class="col-12">
                    <div><b>Type</b></div><br>

                    <input type="radio" name="type" value="Commercial"> Commercial

                    <input type="radio" name="type" value="Residential" checked> Residential

                    <input type="radio" name="type" value="Agriculture"> Agriculture

                    <input type="radio" name="type" value="Other"> Other
                </div>
            </div>

            <div class="row mt-2"  style="margin-left: 2px;">
                    <div class="col-12">
                    <div class="form-check form-check-inline">
                    <input class="form-check-input" 
                    type="radio" 
                    name="status" 
                    value="Not Available"
                    <%=data.status=='Not Available'?'chaecked':'' %>
                    />
                    <label class="form-check-label"><b>Not Available</b></label>
                    </div>
                    
                    <div class="form-check form-check-inline">
                    <input class="form-check-input" 
                    type="radio" 
                    name="status" 
                    value="Available"
                     <%=data.status=='Available'?'chaecked':'' %>
                    />
                    <label class="form-check-label"><b>Available</b></label>
                    </div>
                    </div>
                </div>
            
            <div class="row mt-4 mb-4">
                <div class="col-6" style="display: flex;justify-content: center;">
                    <button type="submit" value="Edit" name="btn" class="btn btn-primary" style="width: 70%; font-size: 20px;border-radius: 10px;">Edit</button>
                </div>

                <div class="col-6" style="display: flex;justify-content: center;"">
                    <button type="submit" value="Delete" name="btn" class="btn btn-info" style="width: 70%;font-size: 20px;border-radius: 10px;">Delete</button>
                </div>
            </div>        

        </div>
    </div>
</div>
</form>
</body>
</html>