<html>
    <head>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Tinos:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

        <link rel="stylesheet" href="/stylesheets/display.css">
    </head>
    <div class="root">
    <div class="box">
        <div class="boxdiv">

            <div class="circle">
                <img src="/images/house.png" class="logo">
            </div>

            <div class="list">
                <div>Property List</div>
            </div>


            <div class="chek">
                <a href="/property/property_interface" style="cursor: pointer; text-decoration: none;">
                <img src="/images/add.png" class="cheked">
                </a>
            </div>

        </div>


        <table class="table">
            <tr>
                <th>Sno</th>
                <th>Property Id</th>
                <th>State</th>
                <th>
                    <div>City/</div>
                    <div>Place</div>
                </th>
                <th>Owner</th>
                <th>Mobile</th>
                <th>Email</th>
                <th>
                    <div>Area/</div>
                    <div>price</div>
                </th>    
                <th>Type</th>
                <th>Status</th>
                <th>Picture</th>
                <th>Update</th>
            </tr>
                <% data.map((item,i)=>{ %>
            <tr>
                    <td><%=1+i %></td>
                    <td><%=item.propertyid %></td>                   
                    <td><%=item.statename %></td>
                    <td>
                        <div><%=item.cityname %>/</div>
                        <div><%=item.placename %></div>
                    </td>
                    <td><%=item.ownername %></td>
                    <td><%=item.mobileno %></td>
                    <td><%=item.emailid %></td>
                    <td> 
                      <div><%=item.area %>/</div>
                       <div><%=item.price %></div>
                    </td>
                    <td><%=item.type %></td>

                    <td><font color="<%=item.status=='Available'?'green':'red'%>"><%=item.status %></font></td>
                    <td>
                        
                              <a style="cursor: pointer;text-decoration: none;" href="/property/show_picture?propertyid=<%=item.propertyid %>&ownername=<%=item.ownername %>&picture=<%=item.picture %>">
                            <img src="/images/<%=item.picture %>" width="100" height="80">
                            </a>
                        </a>
                    </td>
                    <td><a style="cursor: pointer;text-decoration: none;" href="/property/edit_delete?propertyid=<%=item.propertyid %>">Edit/Delete</a></td></tr>


                <% }) %>
            </tr>
        </table>
        </div>
        </div>
</html>