<html>
    <head>
         <link rel='stylesheet' href='/stylesheets/show.css' />
    </head>
    <body>
    <center class="center">
        
        <form action="/property/edit_picture" method="post" enctype="multipart/form-data">
        <input type="hidden" name="propertyid" value="<%=data.propertyid %>">
        <div>
            <h1>
                <%=data.ownername %>
            </h1>
        </div>

        <div class="image">
            <img src="/images/<%=data.picture %>" width="296px" height="250px">
        </div>
        <div>
            <div class="new"><b>Upload New property Picture:</b></div>
            <div class="file"><input type="file" name="picture" accept="image/*"></div>
            <div>
            <button type="submit" class="upload">Upload</button>
            </div>
        </div>
    </form>
    
    </center>
    </body>

</html>