<html>
<head>
    <title>Profile</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <div class="container mt-5">

        <div class="card p-4 shadow" style="width: 400px; margin: auto; background: pink; border-radius: 10px;">

            <center>

                <img src="/images/<%= data.picture %>"
                     width="120"
                     height="120"
                     style="border-radius: 50%;">

                <h3 class="mt-3"><%= data.adminname %></h3>

                <p><b>Mobile:</b> +91 <%= data.mobileno %></p>

                <p><b>Email:</b> <%= data.emailid %></p>

                <a href="/login/logout" class="btn btn-danger">
                    Logout
                </a>

            </center>

        </div>

    </div>

</body>
</html>