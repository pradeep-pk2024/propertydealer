<html>
    <head>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Tinos:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
        <link rel='stylesheet' href='/stylesheets/login.css' />
    </head>
    <body>
    <div class="main">
        <div  class="container">
            <div class="box">
                <img src="/images/login.jpg" class="image">
                <div class="back">
                    <h2>Welcome Back!</h2>
                    
                </div>
                <div class="login">
                    <h3>L-O-G-I-N</h3>
                    <h6>Please enter your details</h6>   
            <div class="right-box">
                <form action="/login/check_admin_login" method="post">
                        

                        <label></label>
                            <div class="input-box">
                                <input type="email" placeholder="Enter Email" name="emailid">
                                <i class="fas fa-envelope"></i>
                            </div>
                        
                        <label></label>
                            <div class="input-box">
                                <input type="password" placeholder="Enter Password" name="password">
                                <i class="fas fa-lock"></i>
                            </div>
                
                    
                        <div class="extra-links">
                            <a href="#">Forgot Password</a>
                            <a href="#">Register</a>
                        </div>

                    <button type="submit">Log in</button>

                        <div class="text-center">
                            <span>Are you new? </span>
                                <a href="#" class="create-account">Create an Account</a>
                        </div>

                    <div class="message">
                        <span><%=message %></span>
                    </div>

                </form>
                    
            </div>

        </div>
    </div>

        <div class="imagediv">
 
        </div>
</div>
</body>
</html>